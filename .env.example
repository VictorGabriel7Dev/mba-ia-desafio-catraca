# Copie para .env (o compose e os scripts leem daqui). COMPOSE_PROJECT_NAME fixa o
# nome do projeto, então os contêineres/volumes ficam previsíveis.
COMPOSE_PROJECT_NAME=catraca

# Banco de dados (serviço "db" do compose).
POSTGRES_USER=catraca
POSTGRES_PASSWORD=catraca
POSTGRES_DB=catraca

# Porta do Postgres EXPOSTA no host (o padrão do desafio é 5432; mude só se a 5432
# já estiver ocupada na sua máquina). Não afeta a comunicação interna do compose.
DB_HOST_PORT=5432

# URL usada por api/worker DENTRO da rede do compose (host "db", sempre 5432).
DATABASE_URL=postgresql://catraca:catraca@db:5432/catraca?schema=public

# Sessão (JWT). Troque por um valor forte fora de desenvolvimento.
JWT_SECRET=troque-este-segredo-em-producao

# Origem do front, para o CORS da API.
WEB_ORIGIN=http://localhost:5173

# Porta da API dentro do contêiner (exposta em 4000 no host).
PORT=4000

# Base da API usada pelo front (navegador fala com o host).
VITE_API_URL=http://localhost:4000
