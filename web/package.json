{
  "name": "catraca-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Front da Catraca (React + Vite): cadastro e login do participante e guarda de rota de organizador.",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3"
  }
}
